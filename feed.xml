---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{%- comment -%}
  The site had no feed at all, and the notes index linked to nothing subscribable.
  Atom rather than RSS to match the main Wirewalk site, so one reader handles both.
{%- endcomment -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{% if site.posts.first %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.author }}</name></author>
  <rights>&#169; {{ 'now' | date: "%Y" }} {{ site.organization | default: site.title }}</rights>
  {%- for post in site.posts limit: 50 %}
  <entry>
    <title>{{ post.title | escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_reviewed | default: post.date | date_to_xmlschema }}</updated>
    <author><name>{{ site.author }}</name></author>
    {%- for t in post.tags %}
    <category term="{{ t | escape }}"/>
    {%- endfor %}
    <summary type="text">{{ post.summary | default: post.excerpt | strip_html | strip_newlines | escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
